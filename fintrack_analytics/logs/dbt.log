create or replace transient  table fintrack_db.staging_marts.mart_budget_vs_reel
    
    
    
    
    as (with budgets_agreges as (

    select
        compte_id,
        categorie_id,
        mois,
        sum(montant_prevu) as montant_prevu

    from fintrack_db.staging.stg_budgets
    group by compte_id, categorie_id, mois

),

depenses_agregees as (

    select
        compte_id,
        categorie_id,
        mois_transaction as mois,
        sum(montant) as montant_reel

    from fintrack_db.staging_marts.fct_transactions
    where type_operation = 'debit'
    group by compte_id, categorie_id, mois_transaction

),

rapproche as (

    select
        coalesce(b.compte_id, d.compte_id)       as compte_id,
        coalesce(b.categorie_id, d.categorie_id) as categorie_id,
        coalesce(b.mois, d.mois)                 as mois,
        coalesce(b.montant_prevu, 0)             as montant_prevu,
        coalesce(d.montant_reel, 0)              as montant_reel

    from budgets_agreges b
    full outer join depenses_agregees d
        on  b.compte_id    = d.compte_id
        and b.categorie_id = d.categorie_id
        and b.mois          = d.mois

)

select
    r.compte_id,
    c.nom_client,
    r.categorie_id,
    cat.nom_categorie,
    r.mois,
    r.montant_prevu,
    r.montant_reel,
    r.montant_reel - r.montant_prevu as ecart,
    r.montant_reel > r.montant_prevu as depassement

from rapproche r
left join fintrack_db.staging_marts.dim_comptes    c   on r.compte_id    = c.compte_id
left join fintrack_db.staging_marts.dim_categories cat on r.categorie_id = cat.categorie_id
    )

/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.fintrack_analytics.mart_budget_vs_reel", "profile_name": "fintrack_analytics", "target_name": "dev"} */
