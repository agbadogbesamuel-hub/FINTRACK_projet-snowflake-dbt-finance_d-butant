),

enrichi as (

    select
        t.transaction_id,
        t.compte_id,
        c.nom_client,
        c.type_compte,
        t.date_transaction,
        date_trunc('month', t.date_transaction)::date as mois_transaction,
        t.montant,
        t.montant_signe,
        t.type_operation,
        t.categorie_id,
        cat.nom_categorie,
        cat.type_categorie,
        cat.groupe,
        t.description,
        t.statut

    from transactions t
    left join comptes    c   on t.compte_id    = c.compte_id
    left join categories cat on t.categorie_id = cat.categorie_id

)

select * from enrichi
)
